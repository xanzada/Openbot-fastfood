PORT=4100

# Tiered LLM routing
OPENROUTER_API_KEY=
TEXT_PRIMARY_MODEL=deepseek/deepseek-chat
TEXT_FALLBACK_MODEL=deepseek/deepseek-chat-v3
# Media (receipt OCR) runs on the free Gemini keys first and falls back to the
# paid OpenRouter reserve whenever Gemini answers nothing on any key.
#
# MEDIA_USE_FREE_KEYS=true   free keys first, paid reserve as fallback (default)
# MEDIA_USE_FREE_KEYS=false  skip the free keys, go straight to the paid reserve
#
# The free keys carry no Pro quota -- every Pro model returns 429 on all of
# them -- so Pro-tier reading is only reachable through MEDIA_FALLBACK_MODEL.
MEDIA_USE_FREE_KEYS=true
# Comma-separated Google AI Studio keys. Each request starts its sweep one key
# further along so their daily free quotas drain evenly.
MEDIA_PRIMARY_KEYS=
# Verified working on every free key: gemini-3.6-flash, gemini-3.5-flash,
# gemini-3.5-flash-lite, gemini-flash-latest. Do NOT use gemini-2.5-flash-lite,
# which Google has retired (404 on all keys).
MEDIA_PRIMARY_MODEL=gemini-3.6-flash
# Paid reserve, billed per token, so this is the one that costs money. Measured
# on OpenRouter per 1M tokens (in/out): 2.5-flash 0.30/2.50, 2.5-pro 1.25/10.00,
# 3.6-flash 1.50/7.50. 3.6-flash belongs on the free keys above, not here.
MEDIA_FALLBACK_MODEL=google/gemini-2.5-flash

# --- Channel 2: our own project, switched on independently of the client pool.
# Google API keys from a project with billing enabled -- that is what carries Pro
# quota. The free keys above cannot reach Pro at all (429 on every Pro model).
# When MEDIA_PRO_ENABLED=true these keys are tried first and the client pool is
# not touched; on failure the request still falls through to the pool and then to
# the OpenRouter reserve.
MEDIA_PRO_ENABLED=false
MEDIA_PRO_KEYS=
MEDIA_PRO_MODEL=gemini-2.5-pro
TAVILY_API_KEY=

# DLE api_bot.php / CRM
CRM_SECRET_TOKEN=

# OpenBot sends action=operator_sos to api_bot.php for the site operator notification.
# Legacy DLE website webhook receiver.
# DLE_WEBHOOK_AUTH_REQUIRED=false keeps compatibility with the old SPA module, which posts JSON without auth headers.
DLE_WEBHOOK_AUTH_REQUIRED=false
DLE_WEBHOOK_SECRET=

# Shared Redis, reached by WhatsPro too over the external dokploy-network.
# REDIS_PASSWORD is required: docker-compose.yml feeds it to --requirepass and
# builds REDIS_URL from it, so an unset value fails the deploy instead of
# silently starting an open Redis. Keep it alphanumeric so it needs no
# percent-encoding inside the URL. WhatsPro must use the same credentials:
#   REDIS_URL=redis://default:<REDIS_PASSWORD>@redis:6379
REDIS_PASSWORD=change-me-to-a-long-random-alphanumeric-secret
# Only for running the bot outside docker (npm run dev). Inside the stack the
# compose environment block builds this from REDIS_PASSWORD and wins over .env.
REDIS_URL=redis://default:change-me-to-a-long-random-alphanumeric-secret@127.0.0.1:6379

# NocoDB restaurant config and shpor tables
# Restaurants table must contain instance_id and dev_phone.
NOCODB_URL=
NOCODB_TOKEN=
NOCODB_TABLE_ID=

# Standalone WhatsPro service
WHATSPRO_BASE_URL=
WHATSPRO_SEND_URL=
WHATSPRO_PRESENCE_URL=
WHATSPRO_API_TOKEN=
OPENBOT_WEBHOOK_SECRET=

# Inbound protection and delivery pacing
OPENBOT_SPAM_LIMIT_PER_MINUTE=15
OPENBOT_SPAM_MUTE_SECONDS=900
OPENBOT_MAX_MEDIA_BYTES=5242880
OPENBOT_INBOUND_BUFFER_MS=1200
OPENBOT_MAX_IMAGE_BYTES=5242880
OPENBOT_MAX_DOCUMENT_BYTES=5242880
OPENBOT_MAX_AUDIO_BYTES=8388608
OPENBOT_MAX_VOICE_SECONDS=180
OPENBOT_MEDIA_AI_LIMIT_PER_5_MINUTES=6
OPENBOT_RESPONSE_CHUNK_MAX=650
# Suppress identical developer alerts per instance for this many seconds.
OPENBOT_DEV_ALERT_DEDUPE_SECONDS=60
# Failed replies: outbox:whatspro:<sha256> (24h). Failed dev alerts: dev_alert_outbox:<instance>:<incident> (7d).
OPERATOR_MUTE_MAX_SECONDS=300

# AI-human handoff: WhatsPro writes operator_active:{instanceId}:{phone}; Openbot reads it.
# Openbot creates red Chat handoff records in operator_case:* / operator_cases:* and bumps chatwoot:inbox:*.
OPERATOR_ACTIVE_SECONDS=60

# Private-contact filters
BOT_IGNORE_SAVED_CONTACTS=false
PRIVATE_CONTACT_KEYWORDS=мама,мам,папа,пап,ана,әке,аке,апа,ата,әже,аже,нағашы,нагашы,аға,ага,әпке,апке,тәте,тате,көке,коке,брат,сестра,жена,муж,дос,бауырым,карындас,қарындас,сіңлі,синли

# Strict test mode. When enabled, every inbound phone except the restaurant's NocoDB dev_phone is ignored.
TEST_MODE_ENABLED=false

# Daily analytics cron
ANALYTICS_TIMEZONE=Asia/Almaty
ANALYTICS_CRON_EXPR=59 23 * * *

# Strict Gemini receipt validation. Set false temporarily for testing/rollback.
RECEIPT_AI_FILTER_ENABLED=true

# Kanban/n8n outbound sync
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_TIMEOUT_MS=5000
