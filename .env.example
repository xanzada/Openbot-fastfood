PORT=4100

# OpenRouter OpenAI-compatible endpoint
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=google/gemini-2.5-flash

# DLE api_bot.php / CRM
CRM_SECRET_TOKEN=

# Redis
REDIS_URL=redis://localhost:6379

# NocoDB restaurant config and shpor tables
NOCODB_URL=
NOCODB_TOKEN=
NOCODB_TABLE_ID=
NOCODB_SHPOR_TABLE_ID=
SHPOR_CONTEXT_LIMIT=8

# Standalone WhatsPro service
WHATSPRO_BASE_URL=
WHATSPRO_SEND_URL=
WHATSPRO_PRESENCE_URL=
WHATSPRO_API_TOKEN=
OPENBOT_WEBHOOK_SECRET=

# Inbound protection and delivery pacing
OPENBOT_SPAM_LIMIT_PER_MINUTE=15
OPENBOT_SPAM_MUTE_SECONDS=900
OPENBOT_MAX_MEDIA_BYTES=15728640
OPENBOT_RESPONSE_CHUNK_MAX=650

# Kanban/n8n outbound sync
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_TIMEOUT_MS=5000
